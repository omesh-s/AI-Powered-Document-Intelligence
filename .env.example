# --- API ---
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=change-me-use-openssl-rand-hex-32
API_JWT_ACCESS_EXPIRE_MINUTES=30
API_JWT_REFRESH_EXPIRE_DAYS=14
API_CORS_ORIGINS=http://localhost:5173

# Postgres (async URL for app; Alembic uses sync derived from this or DATABASE_SYNC_URL)
DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5432/docintel
DATABASE_SYNC_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage (S3-compatible: MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=documents
S3_PRESIGN_EXPIRES_SECONDS=3600

# Vector store: pgvector inside Postgres (embedding dimension must match embedding model)
VECTOR_BACKEND=pgvector
EMBEDDING_DIMENSION=1536

# Providers (stubs acceptable without keys)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# OCR (optional external service URL)
OCR_PROVIDER=stub

# Rate limits (requests per minute)
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=8
RATE_LIMIT_UPLOAD_URL_PER_MINUTE=30
RATE_LIMIT_DOCUMENT_CREATE_PER_MINUTE=30

# Upload validation
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
